# Chọn nhà cung cấp LLM: gemini hoặc openai (hỗ trợ OpenAI, Groq, OpenRouter...)
LLM_PROVIDER=gemini

# Khóa API (KHÔNG commit file .env thật lên Git)
LLM_API_KEY=your_api_key_here

# Tên model (ưu tiên model nhỏ, nhanh, chi phí thấp cho bản demo)
# Ví dụ Gemini: gemini-2.0-flash hoặc gemini-2.5-flash
# Ví dụ OpenAI: gpt-4o-mini
# Ví dụ Groq: llama-3.1-8b-instant
LLM_MODEL=gemini-2.0-flash

# Tùy chọn: chỉ cần điền nếu dùng endpoint OpenAI-compatible khác (vd: Groq/OpenRouter)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Thời gian chờ tối đa (giây) cho mỗi lần gọi LLM API
LLM_TIMEOUT=20
