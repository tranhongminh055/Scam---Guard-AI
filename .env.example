# Chọn nhà cung cấp LLM: ollama (chạy local miễn phí), gemini, hoặc openai
LLM_PROVIDER=ollama

# Khóa API (BỎ TRỐNG nếu dùng ollama; KHÔNG commit file .env thật lên Git)
LLM_API_KEY=

# Tên model
# - Ollama (local, hiểu tiếng Việt tốt): qwen2.5:7b hoặc qwen2.5:3b
# - Gemini: gemini-2.0-flash hoặc gemini-2.5-flash
# - OpenAI: gpt-4o-mini | Groq: llama-3.1-8b-instant
LLM_MODEL=qwen2.5:3b

# Endpoint tùy chọn (mặc định Ollama: http://localhost:11434)
# LLM_BASE_URL=http://localhost:11434

# Thời gian chờ tối đa (giây) cho mỗi lần gọi LLM (nên đặt 60 nếu chạy Ollama trên CPU)
LLM_TIMEOUT=60
